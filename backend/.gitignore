# Backend-specific .gitignore

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual Environment
venv/
env/
ENV/
env.bak/
venv.bak/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Environment Variables
.env
.env.local
.env.*.local

# Database
*.db
*.sqlite
*.sqlite3

# Uploads and temporary files
uploads/
tmp/
temp/
*.tmp

# Logs
*.log
logs/
log/

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# OS specific
.DS_Store
._*
Thumbs.db

# ML Models - Uncomment if you don't want to track trained models
# nirikshan ml/*.pkl
# nirikshan ml/*.csv