# NIRIKSHAN Backend Configuration
# Copy this file to .env and fill in your actual values

# Database Configuration
# Format: postgresql+psycopg://username:password@localhost:5432/database_name
DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/nirikshan

# For development/testing with SQLite (not recommended for production)
# DATABASE_URL=sqlite:///./nirikshan.db

# JWT Configuration
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Configuration
# Comma-separated list of allowed origins.
# On Vercel, all *.vercel.app and *.vercel.sh domains are auto-allowed by the app code.
# Add your custom production domain here if you have one.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# File Upload Configuration
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=10485760  # 10MB in bytes

# API Configuration
PORT=8000
HOST=0.0.0.0

# Environment
ENVIRONMENT=development  # development, staging, production

# ML Configuration
# Defaults to backend/ml_models/ — the .pkl files should be copied there (see vercel.json setup).
# Override this only if you store models elsewhere.
# ML_MODELS_PATH=/absolute/path/to/ml_models
ML_CONFIDENCE_THRESHOLD=0.7
