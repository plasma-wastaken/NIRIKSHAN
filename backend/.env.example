# NIRIKSHAN Backend Configuration
# Copy this file to .env and fill in your actual values

# Database Configuration
# Format: postgresql+psycopg://username:password@localhost:5432/database_name
DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/nirikshan

# For development/testing with SQLite (not recommended for production)
# DATABASE_URL=sqlite:///./nirikshan.db

# JWT Configuration
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Configuration
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# File Upload Configuration
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=10485760  # 10MB in bytes

# API Configuration
PORT=8000
HOST=0.0.0.0

# Environment
ENVIRONMENT=development  # development, staging, production

# ML Configuration
ML_MODELS_PATH=../nirikshan ml
ML_CONFIDENCE_THRESHOLD=0.7
